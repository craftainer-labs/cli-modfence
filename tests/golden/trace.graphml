<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="node_id" for="node" attr.name="id" attr.type="string"/>
  <key id="n_kind" for="node" attr.name="kind" attr.type="string"/>
  <key id="n_label" for="node" attr.name="label" attr.type="string"/>
  <key id="n_lang" for="node" attr.name="lang" attr.type="string"/>
  <key id="n_path" for="node" attr.name="path" attr.type="string"/>
  <key id="n_symbol_kind" for="node" attr.name="symbol_kind" attr.type="string"/>
  <key id="n_span" for="node" attr.name="span" attr.type="string"/>
  <key id="n_tags" for="node" attr.name="tags" attr.type="string"/>
  <key id="n_binding" for="node" attr.name="binding" attr.type="string"/>
  <key id="e_relation" for="edge" attr.name="relation" attr.type="string"/>
  <key id="e_confidence" for="edge" attr.name="confidence" attr.type="string"/>
  <key id="e_origin" for="edge" attr.name="origin" attr.type="string"/>
  <key id="e_count" for="edge" attr.name="count" attr.type="int"/>
  <key id="e_specifier" for="edge" attr.name="specifier" attr.type="string"/>
  <key id="e_sites" for="edge" attr.name="sites" attr.type="string"/>
  <graph id="modfence" edgedefault="directed">
    <node id="n0">
      <data key="node_id">ext:py:requests</data>
      <data key="n_kind">external</data>
      <data key="n_label">requests</data>
      <data key="n_lang">py</data>
      <data key="n_tags">{&quot;boundary&quot;:[&quot;network&quot;]}</data>
    </node>
    <node id="n1">
      <data key="node_id">mod:py:pkg/orders.py</data>
      <data key="n_kind">module</data>
      <data key="n_label">pkg/orders.py</data>
      <data key="n_lang">py</data>
      <data key="n_path">pkg/orders.py</data>
      <data key="n_tags">{&quot;layer&quot;:[&quot;domain&quot;]}</data>
    </node>
    <edge id="e0" source="n1" target="n0">
      <data key="e_relation">imports</data>
      <data key="e_confidence">resolved</data>
      <data key="e_origin">tree-sitter</data>
      <data key="e_count">1</data>
      <data key="e_specifier">requests</data>
      <data key="e_sites">[{&quot;path&quot;:&quot;pkg/orders.py&quot;,&quot;span&quot;:{&quot;end_column&quot;:16,&quot;end_line&quot;:1,&quot;start_column&quot;:1,&quot;start_line&quot;:1}}]</data>
    </edge>
  </graph>
</graphml>
