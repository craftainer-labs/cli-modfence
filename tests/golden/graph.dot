digraph "modfence" {
  rankdir=LR;
  subgraph cluster_0 {
    label="pkg";
    n1 [id="mod:py:pkg/orders.py", label="pkg/orders.py", shape=ellipse];
  }
  n0 [id="ext:py:requests", label="requests", shape=diamond];
  n2 [id="pkg:py:pkg", label="pkg", shape=box];
  n1 -> n0 [style=solid, arrowhead=normal];
  n2 -> n1 [style=solid, color="gray75", arrowhead=normal];
}
